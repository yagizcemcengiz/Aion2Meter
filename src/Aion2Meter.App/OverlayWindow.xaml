<Window x:Class="Aion2Meter.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion2Meter Live Overlay" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#E9EDF5" FontFamily="Segoe UI" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True"
        Loaded="OverlayLoaded" Closing="OverlayClosing" Closed="OverlayClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EDF5" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#AEBACB" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="7,4" />
            <Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" Background="#263345"><Border x:Name="PART_Indicator" Background="#6EE7B7" HorizontalAlignment="Left" CornerRadius="1" /></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Panel" Width="420" Background="#EF111827" BorderBrush="#44556870" BorderThickness="1" CornerRadius="8">
        <Grid Margin="12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragHeader" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aion2Meter" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="CURRENT" FontSize="9" Foreground="#8494AA" Margin="10,3,0,0" />
                </StackPanel>
                <Button x:Name="LockButton" Grid.Column="1" Content="Unlocked" Click="LockClicked" ToolTip="Lock or unlock dragging" />
                <Button Grid.Column="2" Content="Settings" Click="SettingsClicked" ToolTip="Open Aion2Meter controls" />
                <Button Grid.Column="3" Content="×" FontSize="18" Click="CloseClicked" ToolTip="Stop live meter and close overlay" />
            </Grid>
            <Grid Grid.Row="1">
                <StackPanel Margin="0,5,0,15">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <TextBlock Text="{Binding Status}" FontSize="15" Margin="0,3,0,5">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EDF5" />
                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Data unavailable"><Setter Property="Foreground" Value="#FBBF24" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#98A8BE" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,2,0,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Rank}" Foreground="#8494AA" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                <Border Background="#243F3A" CornerRadius="3" Margin="8,0,0,0" Padding="5,2" Visibility="{Binding IsSelf, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="ME" Foreground="#8CEBC6" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Dps}" FontSize="24" FontWeight="SemiBold" Foreground="#8CEBC6" />
                                <TextBlock Text="DPS" FontSize="10" Foreground="#98A8BE" VerticalAlignment="Bottom" Margin="6,0,0,5" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,8">
                                <TextBlock Text="{Binding Damage}" FontSize="12" />
                                <TextBlock Text=" DAMAGE" FontSize="9" Foreground="#8494AA" Margin="4,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Contribution}" FontSize="11" Foreground="#98A8BE" HorizontalAlignment="Right" Margin="0,5,0,8" />
                            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding ContributionValue, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Elapsed}" FontSize="11" Foreground="#C3CFDF" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" Foreground="#8494AA" Margin="10,1,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Coverage}" FontSize="10" Foreground="#8494AA" ToolTip="{Binding CoverageDetails}" Margin="10,1,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
