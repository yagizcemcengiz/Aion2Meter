<Window x:Class="Aion2Meter.App.OverlaySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aion2Meter · Settings" Width="440" SizeToContent="Height" ResizeMode="NoResize" Background="#121C2C" Foreground="#E9EDF5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="SettingsClosing">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE5F3"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#26384E"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#354F6F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#223047"/><Setter Property="Foreground" Value="#E9EDF5"/><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#425371"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE5F3"/></Style>
 </Window.Resources>
 <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Background="#121C2C">
 <StackPanel Margin="24,20">
  <TextBlock Text="Aion2Meter" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Your CURRENT encounter, at a glance." FontSize="12" Foreground="#91A6C2" Margin="0,5,0,20"/>
  <TextBlock Text="NETWORK ADAPTER" FontSize="10" Foreground="#91A6C2" Margin="0,0,0,7"/>
  <ComboBox x:Name="Adapter" DisplayMemberPath="FriendlyName" Padding="7" Margin="0,0,0,9"/>
  <WrapPanel><Button x:Name="StartButton" Content="Start meter" Click="StartClicked"/><Button x:Name="StopButton" Content="Stop" Click="StopClicked"/><Button x:Name="RefreshButton" Content="Refresh adapters" Click="RefreshClicked"/></WrapPanel>
  <TextBlock x:Name="SessionStatus" Text="Meter stopped" FontSize="11" Foreground="#91A6C2" TextWrapping="Wrap" Margin="0,10,0,5"/>
  <TextBlock x:Name="ErrorText" Foreground="#F4BD77" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Border Height="1" Background="#2B3C53" Margin="0,0,0,14"/>
  <TextBlock Text="My Class" Margin="0,0,0,7"/>
  <ComboBox x:Name="MyClass" DisplayMemberPath="Label" SelectedValuePath="Value" Padding="7" SelectionChanged="ClassChanged"/>
  <TextBlock Text="Used only when Aion2Meter cannot detect your class automatically." FontSize="10" Foreground="#91A6C2" TextWrapping="Wrap" Margin="0,6,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Opacity"/><TextBlock x:Name="OpacityValue" Grid.Column="1" Foreground="#91A6C2"/></Grid>
  <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" TickFrequency="0.05" ValueChanged="StyleChanged" Margin="0,7,0,12"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Scale"/><TextBlock x:Name="ScaleValue" Grid.Column="1" Foreground="#91A6C2"/></Grid>
  <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="1.5" TickFrequency="0.05" ValueChanged="StyleChanged" Margin="0,7,0,12"/>
  <CheckBox x:Name="LockDragging" Content="Lock overlay position and size" Checked="LockChanged" Unchecked="LockChanged" Margin="0,0,0,17"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Hide / show shortcut" FontSize="11" Margin="0,0,0,6"/><TextBlock Grid.Column="1" Text="Reset CURRENT shortcut" FontSize="11" Margin="8,0,0,6"/>
   <TextBox x:Name="HideShortcut" Grid.Row="1"/><TextBox x:Name="ResetShortcut" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"/>
  </Grid>
  <TextBlock Text="Ctrl / Alt / Win + letter, digit or F1–F11. Optional Shift." FontSize="10" Foreground="#91A6C2" Margin="0,6,0,10"/>
  <Button Content="Apply shortcuts" Click="ApplyShortcuts" HorizontalAlignment="Left"/>
  <TextBlock x:Name="HotkeyStatus" FontSize="11" Foreground="#F4BD77" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <WrapPanel><Button Content="Show overlay" Click="ShowClicked"/><Button Content="Reset CURRENT" Click="ResetClicked"/></WrapPanel>
  <TextBlock Text="Reset clears the encounter; the meter keeps running." FontSize="10" Foreground="#91A6C2" Margin="0,8,0,16"/>
  <Border Height="1" Background="#2B3C53" Margin="0,0,0,14"/>
  <Button x:Name="ExportDiagnosticsButton" Content="Export diagnostics" Click="ExportDiagnosticsClicked" HorizontalAlignment="Left" Margin="0,0,0,12"/>
  <DockPanel><Button x:Name="AdvancedButton" Content="Advanced / research" Click="AdvancedClicked" DockPanel.Dock="Left"/><Button Content="Done" Click="DoneClicked" HorizontalAlignment="Right"/></DockPanel>
 </StackPanel>
 </ScrollViewer>
</Window>
