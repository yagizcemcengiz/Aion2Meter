<Window x:Class="Aion2Meter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion2Meter — Phase 3A Protocol Research"
        Width="1060" Height="1000" MinWidth="820" MinHeight="650"
        Loaded="WindowLoaded" Closing="WindowClosing" Background="#F4F6FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Capture diagnostics" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Phase 3A • Passive capture • Offline protocol research" Foreground="#536174" Margin="0,6,0,18" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Network Adapter:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DockPanel>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh Adapters" Click="RefreshClicked" Margin="12,0,0,0" />
                <ComboBox x:Name="AdapterCombo" ItemsSource="{Binding Adapters}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedAdapter}" MinHeight="34" />
            </DockPanel>
            <TextBlock Text="{Binding SelectedAdapter.Details}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       Foreground="#536174" Margin="0,10,0,12" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,16">
          <WrapPanel>
            <Button x:Name="StartButton" Content="Start Capture" Click="StartClicked" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Stop Capture" Click="StopClicked" IsEnabled="False" />
            <Button x:Name="CountdownButton" Content="Start 10s Test Countdown" Click="CountdownClicked" IsEnabled="False" />
          </WrapPanel>
          <TextBlock Text="{Binding CountdownStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="5" Background="White" Padding="14" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding NpcapStatus, StringFormat=Npcap: {0}}" />
                <TextBlock Text="{Binding CaptureStatus, StringFormat=Capture: {0}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#92400E" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="6" Background="White" Padding="14" CornerRadius="6" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="Statistics" FontWeight="SemiBold" Margin="0,0,0,6" />
                <UniformGrid Columns="3">
                    <TextBlock Text="{Binding PacketsPerSecond, StringFormat=Packets/sec: {0:N1}}" />
                    <TextBlock Text="{Binding TotalPackets, StringFormat=Total packets: {0:N0}}" />
                    <TextBlock Text="{Binding TotalBytes, StringFormat=Total bytes: {0:N0}}" />
                    <TextBlock Text="{Binding TcpCount, StringFormat=TCP: {0:N0}}" />
                    <TextBlock Text="{Binding UdpCount, StringFormat=UDP: {0:N0}}" />
                    <TextBlock Text="{Binding OtherCount, StringFormat=Other: {0:N0}}" />
                </UniformGrid>
                <TextBlock Text="{Binding DropSummary}" Foreground="#536174" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="7" Margin="0,0,0,12">
            <TextBlock Text="Capture directory:" FontWeight="SemiBold" />
            <TextBox Text="{Binding CaptureDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
            <TextBlock Text="Current File:" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox Text="{Binding CurrentFile, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,4,0,12">
            <TextBlock Text="PROCESS / TRAFFIC DISCOVERY" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Process:" />
            <DockPanel Margin="0,6,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="ProcessRefreshButton" Content="Refresh Processes" Click="ProcessRefreshClicked" />
                    <Button x:Name="ConnectionsRefreshButton" Content="Refresh Connections" Click="ConnectionsRefreshClicked" />
                </StackPanel>
                <ComboBox x:Name="ProcessCombo" ItemsSource="{Binding Processes}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedProcess}" MinHeight="34" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Height="150" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                    <DataGridTextColumn Header="Local Endpoint" Binding="{Binding LocalEndpoint}" Width="*" />
                    <DataGridTextColumn Header="Remote Endpoint" Binding="{Binding RemoteEndpoint}" Width="*" />
                    <DataGridTextColumn Header="State" Binding="{Binding TcpState}" Width="100" />
                    <DataGridTextColumn Header="IP Version" Binding="{Binding IpVersion}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Capture Mode:" FontWeight="SemiBold" />
            <ComboBox x:Name="CaptureModeCombo" SelectedIndex="0" Margin="0,6,0,8" MinHeight="30">
                <ComboBoxItem Content="All Traffic" /><ComboBoxItem Content="Selected Process Traffic" />
            </ComboBox>
            <TextBlock Text="Npcap filters IP/port/protocol, not PID. Shared or reused endpoints can cause false positives. Connections are a snapshot at start; refresh and start a new session to include new endpoints."
                       TextWrapping="Wrap" Foreground="#92400E" Margin="0,0,0,8" />
            <TextBlock Text="Session Label:" />
            <TextBox x:Name="SessionLabelBox" Text="session" MaxLength="160" Margin="0,4,0,8" />
            <TextBlock Text="User Notes (saved only in local metadata):" />
            <TextBox x:Name="UserNotesBox" MaxLength="4000" Margin="0,4,0,4" />
        </StackPanel>
        <Expander x:Name="DiagnosticLogExpander" Grid.Row="8" IsExpanded="False">
          <Expander.Style>
            <Style TargetType="Expander">
              <Setter Property="Header" Value="Show Diagnostic Log" />
              <Style.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter Property="Header" Value="Hide Diagnostic Log" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Expander.Style>
          <Grid Height="210" Margin="0,8,0,0" RequestBringIntoView="DiagnosticLogRequestBringIntoView">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Diagnostic log • Last 100 messages" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Expander>
    </Grid>
    </ScrollViewer>
</Window>
